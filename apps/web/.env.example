# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# ── Premium unlock ──────────────────────────────────────────────────────────
# Required for the premium report. Any random string of 16+ characters will do
# in development:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Without it /api/checkout returns 503 rather than signing with an empty string,
# which would make every forged entitlement token validate.
WRAPPED_SIGNING_SECRET=

# Leave unset while building. /api/checkout is a mock till that mints an
# entitlement for free; setting this to true makes it refuse, so a deploy cannot
# quietly hand out paid reports once a real payment provider is wired up.
# WRAPPED_PAYMENTS_LIVE=true

# ── AI ──────────────────────────────────────────────────────────────────────
# Set one of these. Without either, the AI memory slide reports itself
# unavailable and the premium report is built deterministically from your own
# statistics and labelled as a sample. Everything else works.
#
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Which one to use, when the server holds both keys. Unset means "whichever key
# is present", and Anthropic wins a tie only because the prompts were written
# against it.
# WRAPPED_PROVIDER=openai

# Any host that speaks the OpenAI chat-completions format — not only OpenAI's.
# Point this at your vendor and set OPENAI_API_KEY to their key.
# WRAPPED_OPENAI_BASE_URL=https://api.openai.com/v1

# Which model writes each stage. These strings are passed to whichever provider
# is active, so they must be that provider's own model ids — a Claude id on the
# OpenAI path is rejected by the host, and the other way round.
# WRAPPED_AI_MODEL=claude-opus-5         # the free memory slide
# WRAPPED_DETECTIVE_MODEL=claude-opus-5  # stage 4, finds the patterns
# WRAPPED_WRITER_MODEL=claude-opus-5     # stage 7, writes the slides
# WRAPPED_PREMIUM_MODEL=claude-opus-5    # the legacy one-shot report

# ── Diagnosing a failed generation ──────────────────────────────────────────
# Every way a generation can fail — an unknown model id, a refused key, a reply
# that was cut off, a reply that failed validation twice — reaches the reader as
# the same 502 and the same sentence, and the cause goes only to the server log.
# On a preview deployment that log costs several minutes of authentication to
# read, so this puts the provider's own words in the response body instead.
#
# Leave unset everywhere a reader can reach. The detail can quote a model id, a
# billing state, or a fragment of the reply.
# WRAPPED_DEBUG_ERRORS=1

# ── Abuse limits ────────────────────────────────────────────────────────────
# Per-IP request limits for the routes that cost money. Unset is fine locally
# and the server says so at startup; on any deploy that also sets
# ANTHROPIC_API_KEY these are what stand between a script in a loop and your
# Anthropic bill. Create a free database at console.upstash.com and paste the
# REST url and token — this is a key-value store with expiring counters, not a
# database of anything about your users.
#
# Set these in the Vercel project as well, or add the Firewall rule described
# in SECURITY.md, or both. Both is the recommendation.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=
