# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# ── Premium unlock ──────────────────────────────────────────────────────────
# Required for the premium report. Any random string of 16+ characters will do
# in development:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Without it /api/checkout returns 503 rather than signing with an empty string,
# which would make every forged entitlement token validate.
WRAPPED_SIGNING_SECRET=

# Leave unset while building. /api/checkout is a mock till that mints an
# entitlement for free; setting this to true makes it refuse, so a deploy cannot
# quietly hand out paid reports once a real payment provider is wired up.
# WRAPPED_PAYMENTS_LIVE=true

# ── AI ──────────────────────────────────────────────────────────────────────
# Optional. Without it the AI memory slide reports itself unavailable and the
# premium report is built deterministically from your own statistics and
# labelled as a sample. Everything else works.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides.
# WRAPPED_AI_MODEL=claude-opus-5
# WRAPPED_PREMIUM_MODEL=claude-opus-5
